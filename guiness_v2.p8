-- escape of the guiness
-- jakob
function _init()
    -- slutt れし gjれまre farge 0 (svart) gjennomsiktig
    palt(0, false)
    
    -- bestem en annen farge som skal vれすre gjennomsiktig, f.eks. farge 14 (lyserれまd)
    palt(14, true)
    
    -- (resten av _init-koden din fortsetter her...)
    poke(0x5f2d, 1) --mouse devkit
    poke(0x5f36,0x2) -- even circles
    _set_fps(60)
    entityinit()
end

function _update60()
	if not game_over then
	snwmake()
	bgsnwmake()
		timer +=1 
		slingshot_update()
		move_player(player)
		updatevariables()
		display_zone_name()
		rnd_ambientsound()
		check_win()
		if btn(⬆️) then player.vy =-3 end
		if btn(⬅️) then player.vx =-2 end
		if btn(➡️) then player.vx =2 end
		if btn(⬇️) then player.vx =0 end


	end
	updatemouse()
	if game_over then _game_over_delay_counter +=1 end
end

function _draw()
	cls(0)
	camera(cam.x,cam.y)
	prtdraw(bgsnw)
	--print(player.x, cam.x,cam.y)
	--print(player.y, cam.x,cam.y+7)
	
	-- tegner tれしrnet basert pれし mapsegs
	for i=1,#mapsegs do
		local seg = mapsegs[i]
		local world_y = -(i-1)*256
		map(seg.mx, seg.my, 0, world_y, 32, 32)
	end
	
	draw_player()
	draw_grab_point()
	draw_trajectory()
	draw_particles()
	if game_over and _game_over_delay_counter >= _game_over_delay then draw_victory_screen() end
	draw_big_text()
	prtdraw(snw)
	draw_mouse()
end
